# Bu dosyayi .env olarak kopyalayin ve kendi degerlerinizi yazin.
# .env dosyasi git'e eklenmez.

# Veritabani
DB_URL=jdbc:postgresql://localhost:5433/pharmacy_db
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# E-posta (Gmail icin uygulama sifresi kullanin)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
# Gonderen adresi (bos birakilirsa MAIL_USERNAME kullanilir)
# MAIL_FROM=your-email@gmail.com

# Istege bagli
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:3000
